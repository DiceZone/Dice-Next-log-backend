# Dice!Next Log Service —— 环境变量示例。复制为 .env 后按需修改。
# 保留期限、大小上限等运行中可调的项目不在这里，请登录 /admin 后台设置。

# ── 站点配置的默认值 ─────────────────────────────────
# FRONTEND_URL、CORS_ORIGINS、TRUST_PROXY_HEADER、ORIGIN_AUTH_HEADER、ORIGIN_AUTH_TOKEN、
# BDC_VERIFY_URL、BDC_VERIFY_TOKEN、LEGACY_UPSTREAM_URL 这几项只在首次启动时作为默认值，之后在后台「设置 → 站点配置」修改，
# 保存后立即生效；后台改过之后，这里的值不再起作用。

# 染色器（前端）地址：用于生成日志分享链接，并决定 CORS 放行的来源。
FRONTEND_URL=https://你的染色器域名

# ── 监听 ─────────────────────────────────────────────
PORT=8787
# 放在反向代理后面时建议改为 127.0.0.1
HOST=0.0.0.0
# 数据目录：SQLite 数据库与本地缓存（上传的日志先写到这里）。请放在本地磁盘上。
DATA_DIR=./data

# ── 存储位置 ─────────────────────────────────────────
# 日志本体的最终存放位置，格式为 名称=路径，多个用逗号分隔。路径须是已挂载好的目录
# （例如挂载的对象存储）；Docker 部署时写容器内的路径。
# 名称会记在每份日志上，定下后不要改；不填则日志只存在数据目录里。
# 新位置要在后台「设置 → 存储位置」初始化并设为写入位置后才会使用。
STORAGES=
# 例：STORAGES=cos=/storage/cos/dice-next-log,nas=/storage/nas
# 首次启动时的默认写入位置（之后以后台设置为准）；该位置须先初始化，否则仍写入本地。
# 也可在服务器执行 node cli.mjs storage-init <名称> 完成初始化。
STORAGE_TARGET=local

# ── 反向代理 / CDN ───────────────────────────────────
# 取访客真实 IP 用的请求头（限频依赖它）。直接对外服务时留空。
# 只有在请求一定经过自己的反向代理时才设置，否则访客可以伪造。
TRUST_PROXY_HEADER=
# 回源校验：CDN 回源时带上这个请求头与密钥，没带的请求一律拒绝（挡住绕过 CDN 的直连）。
# 建议在后台「设置 → 站点配置」开启，那里保存时会核对 CDN 是否已配好。
ORIGIN_AUTH_HEADER=
ORIGIN_AUTH_TOKEN=
# 后台 Cookie 是否带 Secure：auto 按 x-forwarded-proto 判断 / true / false
COOKIE_SECURE=auto
# 除 FRONTEND_URL 外另外放行的来源，逗号分隔。
CORS_ORIGINS=

# ── 骰娘密钥校验 ─────────────────────────────────────
# 自建站推荐直接在后台「骰娘密钥」页签发，不需要改这里。
# 以下两种是另外的方式，可与后台签发的并存。
# 方式一：交给 BDC 账号站校验。本站只发送骰娘密钥的 SHA-256。
BDC_VERIFY_URL=
BDC_VERIFY_TOKEN=
# 方式二：自建站直接列出允许串流的骰娘密钥，逗号分隔。
LIVE_STATIC_KEYS=

# ── 迁移过渡 ─────────────────────────────────────────
# 旧站地址。本站查不到的日志会转去旧站读取；旧站过了保留期后删掉这一行即可。
LEGACY_UPSTREAM_URL=

# 首次启动时的默认保留天数（之后以后台设置为准）。
LOG_RETENTION_DAYS=365
